{
  "name": "replace-me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report \"$(ls -td test-results/*/report | head -1)\"",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "screenshots": "SCREENSHOT_DIR=screenshots vitest run --project storybook && SCREENSHOT_DIR=screenshots playwright test screens",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm e2e",
    "verify:changed": "node scripts/verify-changed.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "^1.170.45",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.29.4",
    "browserslist-to-esbuild": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.150.0"
  },
  "browserslist": [
    "last 3 Chrome major versions",
    "last 3 Edge major versions",
    "last 3 Firefox major versions",
    "last 3 Safari major versions",
    "last 3 iOS major versions",
    "last 3 ChromeAndroid versions",
    "last 3 FirefoxAndroid versions"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0"
}
